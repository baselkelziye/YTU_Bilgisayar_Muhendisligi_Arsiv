\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces (Left) BPB per run: adaptive (blue) consistently outperforms bwt\_mtf (red) across all 15 runs. (Right) Per-run improvement---every single run beats bwt\_mtf, confirming robustness. Paired t-test: $t = 43.16$, $p < 10^{-6}$.\relax }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:kfold}{{4}{4}{(Left) BPB per run: adaptive (blue) consistently outperforms bwt\_mtf (red) across all 15 runs. (Right) Per-run improvement---every single run beats bwt\_mtf, confirming robustness. Paired t-test: $t = 43.16$, $p < 10^{-6}$.\relax }{figure.caption.4}{}}
