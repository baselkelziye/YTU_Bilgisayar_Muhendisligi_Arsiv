\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces (Left) BPB comparison across chunk sizes---adaptive only beats bwt\_mtf at 1024 bytes. At 4096+ bytes, bwt\_mtf dominates and adaptive provides no benefit. (Right) Algorithm winner distribution at 1024B vs 4096B. Three algorithms compete naturally at 1024B; at 4096B, bwt\_mtf wins virtually everything.\relax }}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:chunk}{{2}{3}{(Left) BPB comparison across chunk sizes---adaptive only beats bwt\_mtf at 1024 bytes. At 4096+ bytes, bwt\_mtf dominates and adaptive provides no benefit. (Right) Algorithm winner distribution at 1024B vs 4096B. Three algorithms compete naturally at 1024B; at 4096B, bwt\_mtf wins virtually everything.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Model Training and Selection}{3}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces (Left) Model accuracy comparison---MLP-Large achieves 84.8\%, outperforming XGBoost and smaller MLP variants. (Right) Per-chunk compression times---the adaptive system is 24\% faster than always using bwt\_mtf because it often selects faster algorithms like LZW or Huffman.\relax }}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:model}{{3}{4}{(Left) Model accuracy comparison---MLP-Large achieves 84.8\%, outperforming XGBoost and smaller MLP variants. (Right) Per-chunk compression times---the adaptive system is 24\% faster than always using bwt\_mtf because it often selects faster algorithms like LZW or Huffman.\relax }{figure.caption.3}{}}
