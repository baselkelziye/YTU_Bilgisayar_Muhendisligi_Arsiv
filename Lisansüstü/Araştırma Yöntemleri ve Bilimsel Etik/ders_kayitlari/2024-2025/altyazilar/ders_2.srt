454
01:32:43,336 --> 01:32:43,595
Yok.

455
01:32:44,515 --> 01:32:45,635
[öğrenci].

456
01:32:47,175 --> 01:32:47,996
İsimler yabancı.

457
01:32:48,036 --> 01:32:48,876
[öğrenci].

458
01:32:51,604 --> 01:33:17,484
[öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci],

459
01:33:19,539 --> 01:33:46,539
[öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci], [öğrenci],

460
01:33:48,500 --> 01:34:14,680
[öğrenci], burada. [öğrenci], [öğrenci]. [öğrenci], burada. [öğrenci] [öğrenci], buradayım hocam. [öğrenci], buradayım hocam. [öğrenci], buradayım hocam. [öğrenci], burada. Buradayım hocam. [öğrenci], [öğrenci], [öğrenci].

461
